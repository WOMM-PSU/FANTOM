# ── Server (apps/server) ───────────────────────────────────────────────
PORT=8080
# Base URL the join URL / QR code points at (the web app).
WEB_BASE_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the HTTP API / WS upgrade.
ALLOWED_ORIGINS=http://localhost:3000
# DEV_ONLY: allows config.devMode = true (simulated aim/GPS shortcuts).
# Never enable this for a real playtest or demo.
ALLOW_DEV_MODE=false

# ── Web (apps/web, Dev B) ──────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
