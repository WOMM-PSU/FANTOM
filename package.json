{
  "name": "fantom",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "dev": "pnpm build && pnpm --parallel -r --if-present run dev",
    "typecheck": "pnpm build && pnpm -r --if-present run typecheck",
    "test": "pnpm build && pnpm -r --if-present run test",
    "sim": "pnpm --filter @fantom/sim-client run start"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
